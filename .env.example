# ---- PrismML llama.cpp fork (pre-built binaries) ----
# Release: https://github.com/PrismML-Eng/llama.cpp/releases/tag/prism-b10709-9a9394a
LLAMA_RELEASE=prism-b10709-9a9394a
# NVIDIA GPU (RTX 4070): linux-cuda-12.4-x64
# Other CUDA: linux-cuda-12.8-x64 | linux-cuda-13.3-x64
# CPU fallback: ubuntu-x64 | ubuntu-arm64
LLAMA_TARGET=linux-cuda-12.4-x64
# Base image must match the CUDA runtime of the tar above.
BASE_IMAGE=nvidia/cuda:12.4.1-runtime-ubuntu22.04

# ---- Model (put the .gguf in ./models/ and set the filename) ----
#   hf download prism-ml/Ternary-Bonsai-2-27B-gguf Ternary-Bonsai-2-27B-PQ2_0.gguf --local-dir models
# PQ2_0  = recommended 2-bit pack (7.2 GB)
# PTQ1_0 = smaller/faster (5.9 GB)
# Vision: also mount mmproj and add "--mmproj /models/Ternary-Bonsai-2-27B-mmproj-Q8_0.gguf" to the command.
MODEL_FILE=Ternary-Bonsai-2-27B-PQ2_0.gguf

# ---- Server ----
PORT=8080
# Keep this modest: 27B KV cache is VRAM-hungry on an 8 GB 4070.
CONTEXT_LENGTH=8192
# Layers offloaded to GPU after the 27B model's ~7.2 GB won't all fit in 8 GB VRAM.
# CUDA OOM -> lower this (e.g. 40-60). Too low -> slow CPU-bound generation (raise it).
NGPU=99